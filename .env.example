# Chave gratuita: https://dash.api-futebol.com.br/cadastrar
# Sem esta variável o app usa o catálogo local dos 20 clubes da Série A.
API_FUTEBOL_KEY=
API_FUTEBOL_CAMPEONATO_ID=10

# Asset Manager — Cartola é público e funciona sem secret.
CARTOLA_BASE_URL=https://api.cartola.globo.com
CARTOLA_PHOTO_FORMAT=220x220.png

# Opcionais: só preencha se tiver conta. Sem chave o provider é ignorado.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_TOKEN=

ASSETS_DIR=./assets
DATA_DIR=./data
ASSET_LOGS_DIR=./logs
REQUEST_TIMEOUT=15
MAX_RETRIES=3
REQUEST_DELAY=0.5
ASSET_SEASON=2026
ASSET_PROVIDERS=cartola,api_football,sportmonks,fallback
